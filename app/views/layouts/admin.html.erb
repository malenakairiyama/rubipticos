<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Rubípticos · Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Bootstrap primero (D13) y después nuestros estilos de app/assets/stylesheets %>
    <%= stylesheet_link_tag "bootstrap.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
      <div class="container-fluid">
        <%= link_to admin_root_path, class: "navbar-brand fw-bold" do %>
          Rubípticos <span class="badge text-bg-warning align-text-top">Admin</span>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#admin-nav"
                aria-controls="admin-nav" aria-expanded="false" aria-label="Abrir menú">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="admin-nav">
          <ul class="navbar-nav me-auto">
            <%# TODO: ruta del admin de Crípticos %>
            <li class="nav-item"><a class="nav-link" href="#">Crípticos</a></li>
            <%# TODO: ruta del admin de Configuración %>
            <li class="nav-item"><a class="nav-link" href="#">Configuración</a></li>
            <%# TODO: ruta del admin de Sincronización %>
            <li class="nav-item"><a class="nav-link" href="#">Sincronización</a></li>
            <%# TODO: ruta del admin de Jugadores %>
            <li class="nav-item"><a class="nav-link" href="#">Jugadores</a></li>
            <%# TODO: ruta del admin de Usuarios %>
            <li class="nav-item"><a class="nav-link" href="#">Usuarios</a></li>
          </ul>
          <%= button_to "Cerrar sesión", session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
        </div>
      </div>
    </nav>

    <main class="container-fluid py-4">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
